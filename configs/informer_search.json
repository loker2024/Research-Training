{
  "_description": "Informer 超参数搜索配置 — 网格搜索空间（128组合 = 2^7）",

  "search_space": {
    "d_model":            [64, 128],
    "n_heads":            [4, 8],
    "n_encoder_layers":   [2, 3],
    "n_decoder_layers":   [1, 2],
    "d_ff":               [128, 256],
    "factor":             [3, 5],
    "dropout":            [0.05, 0.1]
  },

  "fixed": {
    "epochs":       25,
    "patience":     5,
    "batch_size":   32,
    "lr":           0.001,
    "weight_decay": 1e-5,
    "seed":         216,
    "sample_limit": 0,
    "device":       "auto",
    "num_workers":  0,
    "skip_existing": true
  },

  "datasets": ["ETTh1"],
  "horizons": [96]
}