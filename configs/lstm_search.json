{
  "_description": "LSTM 超参搜索配置 — grid search 默认搜索空间",

  "search_space": {
    "hidden_size":    [128, 256],
    "num_layers":     [1, 2],
    "dropout":        [0.1, 0.2],
    "lr":             [3e-4, 1e-3],
    "weight_decay":   [0.0, 1e-5]
  },

  "fixed": {
    "epochs":       25,
    "patience":     5,
    "batch_size":   32,
    "seed":         216,
    "sample_limit": 0,
    "device":       "auto",
    "num_workers":  0,
    "skip_existing": true
  },

  "datasets": ["ETTh1"],
  "horizons": [96]
}
